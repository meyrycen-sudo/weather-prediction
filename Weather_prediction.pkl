
import streamlit as st
import pandas as pd
import pickle

# Configure Page App
st.set_page_config(page_title="Seattle Weather Predictor", page_icon="🌧️")
st.title("🌦️ Weather Prediction Web App")
st.write("Adjust the parameters below to predict the current weather conditions!")

# Load saved pkl model and scaler
@st.cache_resource
def load_model_and_scaler():
     with open('model.pkl', 'rb') as m_file:
         loaded_model = pickle.load(m_file)
     with open('scaler.pkl', 'rb') as s_file:
         loaded_scaler = pickle.load(s_file)
     return loaded_model, loaded_scaler
 
 try:
     model, scaler = load_model_and_scaler()
 except Exception as e:
     st.error(f"Error loading model components: {e}")
     st.stop()
 
# Sidebar/Inputs for user variables
st.header("Input Current Weather Parameters")
precipitation = st.slider("Precipitation (mm)", min_value=0.0, max_value=100.0, value=10.5, step=0.1)
temp_max = st.slider("Maximum Temperature (°C)", min_value=-10.0, max_value=45.0, value=12.0, step=0.5)
temp_min = st.slider("Minimum Temperature (°C)", min_value=-20.0, max_value=35.0, value=5.0, step=0.5)
wind = st.slider("Wind Speed (m/s)", min_value=0.0, max_value=25.0, value=4.5, step=0.1)

# Predict Button
if st.button("Predict Weather condition 🔮"):
     # Map features for scaling and prediction
     input_data = pd.DataFrame([{
         'precipitation': precipitation,
         'temp_max': temp_max,
         'temp_min': temp_min,
         'wind': wind
     }])

# Process data and predict
     input_scaled = scaler.transform(input_data)
     prediction = model.predict(input_scaled)[0]

     # Display predictions beautifully
     weather_emojis = {
         "rain": "🌧️ RAIN",
         "sun": "☀️ SUNNY",
         "drizzle": "🌦️ DRIZZLE",
         "fog": "🌫️ FOGGY",
         "snow": "❄️ SNOW"
     }
 
     emoji_name = weather_emojis.get(prediction.lower(), prediction.upper())
     st.success(f"The predicted weather condition is: **{emoji_name}**")
